# Example only. Do not deploy from this pull request.
# A Worker route on gillundlabs.com requires a DNS decision the owner has not made,
# and the free Worker plan cannot run the password check (10 ms CPU).
# See portal/README.md. Leave every binding empty until that decision.

name = "gillundlabs-test-portal"
main = "worker.js"
compatibility_date = "2026-11-07"
workers_dev = false

